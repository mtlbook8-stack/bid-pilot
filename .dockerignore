# Keep the build context small and free of secrets / dev cruft.
.git
.gitignore
.github
.vscode
.devcontainer
.venv
venv
__pycache__
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
.env
.env.*
!.env.example
**/.DS_Store

# Frontend node_modules and dist — the Docker build stage installs its own deps
# and produces its own dist; sending these in the build context would bloat it.
frontend/node_modules
frontend/dist

# Infra and docs are not needed inside the runtime image.
infra
tests
*.md
!README.md
