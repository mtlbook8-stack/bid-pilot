# BidPilot configuration — copy to `.env` and fill in.
# All variables use the BIDPILOT_ prefix (see src/api/config.py).
# Sensitive values (client secret, function keys) are Key Vault references in
# Azure; locally they are plain strings.

# --- Cosmos DB ---
BIDPILOT_COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
BIDPILOT_COSMOS_DATABASE_NAME=bidpilotdb

# --- Blob Storage ---
BIDPILOT_BLOB_ENDPOINT=https://yourstorage.blob.core.windows.net/
BIDPILOT_BLOB_BIDS_CONTAINER=bids

# --- Key Vault ---
BIDPILOT_KEYVAULT_URI=https://your-keyvault.vault.azure.net/

# --- AI Foundry ---
BIDPILOT_AI_FOUNDRY_ENDPOINT=https://your-foundry.services.ai.azure.com/
BIDPILOT_AI_FOUNDRY_OPENAI_ENDPOINT=https://your-foundry.openai.azure.com/
# API versions are configurable, never hardcoded (decision I8).
BIDPILOT_AI_FOUNDRY_ANTHROPIC_VERSION=2023-06-01
BIDPILOT_AI_FOUNDRY_OPENAI_VERSION=2024-12-01-preview

# --- Document Intelligence ---
BIDPILOT_DOC_INTELLIGENCE_ENDPOINT=https://your-docintel.cognitiveservices.azure.com/

# --- Azure Maps ---
BIDPILOT_AZURE_MAPS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Entra ID (auth + Graph app registration) ---
BIDPILOT_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
BIDPILOT_ENTRA_CLIENT_SECRET=your-client-secret-or-keyvault-reference
# IMPORTANT: leaving BIDPILOT_ENTRA_TENANT_ID EMPTY enables DEV-ONLY auth — the
# API then trusts an `X-Dev-User` header as the user id instead of validating an
# Entra JWT. Set a real tenant id in any deployed environment to enforce SSO.
BIDPILOT_ENTRA_TENANT_ID=

# --- Microsoft Graph ---
# Space-delimited scopes. `.default` requests exactly the consented app perms.
BIDPILOT_GRAPH_SCOPES=https://graph.microsoft.com/.default

# --- Webhook ---
# Public HTTPS URL Graph posts change notifications to. The API derives the
# OAuth redirect URI from this base (origin + /api/auth/callback).
BIDPILOT_WEBHOOK_NOTIFICATION_URL=https://your-api.example.com/api/webhooks/graph

# --- Functions ---
BIDPILOT_FUNCTIONS_BASE_URL=https://your-functions.azurewebsites.net
BIDPILOT_FUNCTIONS_MANUAL_POLL_KEY=your-function-key-or-keyvault-reference

# --- Telemetry ---
BIDPILOT_APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# --- Frontend origin (CORS) ---
# Public origin of the deployed SPA, e.g. https://app.bidpilot.com. Empty in dev.
BIDPILOT_FRONTEND_URL=

# --- Pipeline tuning ---
BIDPILOT_MAX_BID_RETRIES=3
